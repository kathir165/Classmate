# PostgreSQL connection string
# Example (local): postgresql://postgres:password@localhost:5432/classmate
# Example (hosted, e.g. Neon/Supabase): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=7d

# Port the API server listens on
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
